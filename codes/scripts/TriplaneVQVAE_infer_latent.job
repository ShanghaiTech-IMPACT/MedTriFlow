#!/usr/bin/env bash
set -euo pipefail

# Activate the Gen environment before running this script.

PROJECT_ROOT="${PROJECT_ROOT:-/path/to/project}"
cd "$PROJECT_ROOT/codes"
export PYTHONPATH="$PWD"
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Use the same four-GPU mapping as the volume inference script.
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3}"

# Generate latent files through the existing TriplaneVQVAE test_step.
# Only the latent-generation switches differ from volume inference.
exec python run.py \
    -b configs/TriplaneVQVAE.yaml \
    -l "$PROJECT_ROOT/exp" \
    -n TriplaneVQVAE \
    --seed 6033 \
    --not_find_unused_parameters \
    data.params.split_path="$PROJECT_ROOT/data/split-All.npy" \
    data.params.gen_latent=True \
    data.params.fixed_aug=3 \
    model.params.resolution=-1 \
    --test "$PROJECT_ROOT/ckpts/TriplaneVQVAE.ckpt" \
    --output "$PROJECT_ROOT/exp/test_TriplaneVQVAE_infer/infer_latent/"
